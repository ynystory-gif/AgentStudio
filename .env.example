# THEANOVA AgentStudio - safe runtime bootstrap example
# Copying this file is optional. SYSTEM_ADMIN v5.538+ will add these non-secret
# values to root .env automatically if they are missing.
AGENTSTUDIO_BACKEND_PORT=8000
AGENTSTUDIO_FRONTEND_PORT=5173
OLLAMA_AUTO_START=true

# Database credentials, API keys, tokens, passwords and other secrets are NOT
# generated by AgentStudio. Keep those only in your local root .env / secret store.
