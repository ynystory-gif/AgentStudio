Set-Location "F:\Source\repos\Theanova\AI\AgentStudio"

@'
# ==========================================
# THEANOVA AgentStudio .gitignore
# ==========================================

# ------------------------------------------
# 환경변수 / 비밀정보
# ------------------------------------------
.env
.env.*
!.env.example

/backend/.env
/backend/.env.*
!/backend/.env.example

/frontend/.env
/frontend/.env.*
!/frontend/.env.example


# ------------------------------------------
# Python 가상환경
# ------------------------------------------
.venv/
venv/
env/

/backend/.venv/
/backend/venv/
/backend/env/


# ------------------------------------------
# Python 캐시 / 컴파일 파일
# ------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.pytype/

*.egg-info/
.eggs/


# ------------------------------------------
# Python Coverage
# ------------------------------------------
.coverage
.coverage.*
htmlcov/
coverage.xml


# ------------------------------------------
# Node.js / React / Vite
# ------------------------------------------
node_modules/
/frontend/node_modules/

dist/
/frontend/dist/

build/
/frontend/build/

.vite/
/frontend/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ------------------------------------------
# 로그
# ------------------------------------------
logs/
/backend/logs/
/frontend/logs/

*.log
*.err.log
*.out.log

*.pid
*.pid.lock


# ------------------------------------------
# 캐시 / 임시 파일
# ------------------------------------------
cache/
tmp/
temp/

*.tmp
*.temp
*.cache


# ------------------------------------------
# AgentStudio 로컬 임시 데이터
# ------------------------------------------
.agentstudio/sql_scratch/
.agentstudio/cache/
.agentstudio/tmp/
.agentstudio/temp/

/backend/.agentstudio/
/frontend/.agentstudio/


# ------------------------------------------
# 로컬 데이터베이스
# ------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal


# ------------------------------------------
# Jupyter
# ------------------------------------------
.ipynb_checkpoints/


# ------------------------------------------
# IDE / Editor
# ------------------------------------------
.vscode/
.idea/

*.code-workspace


# ------------------------------------------
# OS
# ------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store


# ------------------------------------------
# Python / Windows 임시 파일
# ------------------------------------------
*.bak
*.swp
*.swo
*.orig
*~


# ------------------------------------------
# Windows crash / dump
# ------------------------------------------
*.dmp
*.dump


# ------------------------------------------
# 압축 / 임시 산출물
# 필요 시 Git에 올릴 압축파일은 ! 규칙으로 예외 처리
# ------------------------------------------
*.tmp.zip
*.temp.zip
'@ | Set-Content -Path ".gitignore" -Encoding UTF8