APP_NAME=THEANOVA AgentStudio
APP_ENV=development

# AgentStudio PC 이름 (사용자가 변경 가능, 공용 DB에서 반드시 유니크)
# 최초 실행 시 Windows PC 이름을 기본값으로 사용합니다.
AGENTSTUDIO_PC_NAME=
# 실제 Windows/OS PC 이름 (진단용, Backend가 자동 기록)
AGENTSTUDIO_SYSTEM_HOST_NAME=

# AgentStudio 서비스 포트 (SYSTEM_ADMIN.cmd 재실행 시 적용)
AGENTSTUDIO_BACKEND_PORT=8000
AGENTSTUDIO_FRONTEND_PORT=5173
# 기본/Control DB: AgentStudio는 항상 로컬 PostgreSQL로 먼저 시작합니다.
DATABASE_URL=postgresql+asyncpg://theanova_agentstudio_app:CHANGE_ME@127.0.0.1:5432/theanova_agentstudio
LANGGRAPH_DATABASE_URL=postgresql://theanova_agentstudio_app:CHANGE_ME@127.0.0.1:5432/theanova_agentstudio
AGENTSTUDIO_LOCAL_DATABASE_URL=postgresql+asyncpg://theanova_agentstudio_app:CHANGE_ME@127.0.0.1:5432/theanova_agentstudio
AGENTSTUDIO_LOCAL_LANGGRAPH_DATABASE_URL=postgresql://theanova_agentstudio_app:CHANGE_ME@127.0.0.1:5432/theanova_agentstudio

# Runtime DB 선택: local(기본) 또는 supabase
AGENTSTUDIO_DATABASE_PROVIDER=local
# Supabase 선택 시에만 사용. 비밀정보이므로 app_settings가 아니라 .env에만 저장합니다.
SUPABASE_DATABASE_URL=
SUPABASE_LANGGRAPH_DATABASE_URL=
# Supabase 전용 사용자 스키마. AgentStudio ORM + LangGraph Checkpointer가 이 스키마를 사용합니다.
SUPABASE_DB_SCHEMA=theanova_agentstudio

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_AUTO_START=true
LLM_PROVIDER=ollama
LOCAL_LLM_PROVIDER=ollama
CODING_LLM_PROVIDER=openai
REQUIREMENTS_LLM_PROVIDER=openai
MEMORY_EMBEDDING_PROVIDER=ollama

TAVILY_API_KEY=

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=THEANOVA-AgentStudio

ALLOWED_PROJECT_ROOTS=
MAX_COMMAND_SECONDS=300

AUTO_APPROVE_RISK_LEVEL=1
MAX_DEBUG_ITERATIONS=3
PROJECT_ANALYZER_MAX_FILES=80

MCP_DEFAULT_TIMEOUT_SECONDS=30
MCP_REGISTRY_REFRESH_SECONDS=15

SANDBOX_ROOT=

POSTGRESQL18_ROOT=

DEFAULT_PROJECT_ROOT=
DEFAULT_CACHE_ROOT=
DEFAULT_TEMP_ROOT=
DEFAULT_OUTPUT_ROOT=
COMMON_MODELS_ROOT=
# Google Cloud Firestore (선택)
# DB 연결 화면에서 Service Account JSON 경로를 직접 지정하지 않을 때 사용합니다.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

